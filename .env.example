# Secrets for the dashboard. Run `python3 setup.py` to fill this in interactively,
# or copy this file to .env and edit. .env is gitignored and chmod 600.
#
# Which vars you need depends on your ticket source (chosen in setup / config.json):
#   github  → nothing here; auth comes from the `gh` CLI (`gh auth login`).
#   jira    → JIRA_EMAIL + JIRA_TOKEN below (site URL goes in config.json).
#   mcp     → the MCP_* below (any ticket server speaking the MCP protocol).
#
# Jira ticket source (only if tickets.source = "jira"):
# export JIRA_EMAIL="you@company.com"
# export JIRA_TOKEN="your_api_token"          # id.atlassian.com → Security → API tokens
# (the site URL, e.g. https://you.atlassian.net, lives in config.json under tickets.site)
#
# MCP ticket source (only if tickets.source = "mcp"):
# export MCP_URL="https://your-host/path/to/mcp"   # the MCP server endpoint
# export MCP_KEY="paste_your_key_here"
# export MCP_ASSIGNEE_ID="000"                # your user id on that server
# export MCP_PROJECTS="ABC,DEF"               # optional; empty = all projects
